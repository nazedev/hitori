{
  "name": "hitori",
  "version": "1.2.0",
  "description": "Bot WhatsApp Using Lib Baileys Multi Device",
  "keywords": [
    "whatsapp-bot",
    "baileys-md",
    "bot-wa",
    "multi-device"
  ],
  "author": "Nazedev",
  "license": "MIT",
  "homepage": "https://github.com/nazedev/hitori#readme",
  "bugs": {
    "url": "https://github.com/nazedev/hitori/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nazedev/hitori.git"
  },
  "type": "module",
  "main": "start.js",
  "bin": {
    "hitori": "./cli.js"
  },
  "directories": {
    "lib": "lib",
    "src": "src"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node --expose-gc start.js",
    "dev": "nodemon --expose-gc index.js",
    "debug": "DEBUG=* node --expose-gc start.js",
    "cli": "node cli.js",
    "setup": "node cli.js --setup"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@inquirer/prompts": "^7.0.0",
    "@napi-rs/canvas": "^1.0.3",
    "awesome-phonenumber": "^7.8.0",
    "baileys": "^7.0.0-rc14",
    "boxen": "^8.0.0",
    "chalk": "^5.6.2",
    "chess.js": "^1.4.0",
    "chokidar": "^5.0.0",
    "cli-table3": "^0.6.0",
    "file-type": "^22.0.1",
    "fluent-ffmpeg": "^2.1.3",
    "jimp": "^1.6.1",
    "js-chess-engine": "^2.4.6",
    "mongoose": "^9.8.0",
    "mysql2": "^3.23.1",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "node-webpmux": "^3.2.1",
    "ora": "^8.0.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pureimage": "^0.4.20",
    "qrcode-terminal": "^0.12.0",
    "socket.io-client": "^4.7.5",
    "unzipper": "^0.12.3",
    "yt-search": "^2.13.1",
    "ytdl-core": "npm:@distube/ytdl-core@*"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "baileys": {
      "jimp": "^1.6.1"
    },
    "minimatch": "^3.1.5"
  }
